# video-transcriber settings
# Copy this file to .env and fill in the values:  copy .env.example .env
# .env is git-ignored. Variables already set in the shell ($env:NAME) take precedence.

# ── Transcription engine ────────────────────────────────────────────────────
# Initial engine selection on screen: whisper = local faster-whisper (default) / azure = Azure AI Speech
TRANSCRIBE_ENGINE=whisper

# ── Azure AI Speech (required to select Azure on screen) ────────────────────
AZURE_SPEECH_KEY=
# Either the resource endpoint ...
AZURE_SPEECH_ENDPOINT=
# ... or the region (used only when AZURE_SPEECH_ENDPOINT is empty), e.g. japaneast
AZURE_SPEECH_REGION=
# The language is identified automatically among ja-JP / en-US / zh-CN / de-DE (fixed).
# Phrase list: names / product names / jargon to recognise better (comma separated)
AZURE_PHRASE_LIST=
# Speaker identification (diarization): true / false. Whisper results always have speaker=null.
AZURE_DIARIZATION=true
# Upper bound hint for the number of speakers (2-35). The API has no minimum setting.
AZURE_MAX_SPEAKERS=4
# Response timeout in seconds. The audio is sent as one file (not split): videos of 5 hours or more are rejected.
AZURE_REQUEST_TIMEOUT=3600

# ── GPT translation (optional; translation is skipped when empty) ───────────
OPENAI_API_KEY=

# ── Execution history DB (matches docker-compose.yml) ───────────────────────
DATABASE_URL=postgresql+psycopg2://vt_user:vt_pass@localhost:5432/video_transcriber

# ── Misc ────────────────────────────────────────────────────────────────────
# 1 / true = keep host & container temp folders after a job (for debugging)
KEEP_TEMP_FILES=
# Timeout (seconds) for a single command inside the FFmpeg container
EXEC_TIMEOUT=21600
SHARED_DIR=shared
LOG_DIR=logs
# Per-job result JSON files (never auto-deleted)
RESULTS_DIR=results
